# Скопируйте: cp .env.example .env && nano .env
# Домен должен указывать на этот сервер (A/AAAA) для HTTP-01 Let's Encrypt.

DOMAIN=node.example.com
EMAIL=you@example.com

# Порт API ноды для панели (в файрволе открыть только для IP панели).
NODE_PORT=8080

# SECRET_KEY можно задать здесь и вынести из docker-compose в environment,
# либо оставить только в docker-compose.yml — скрипт up.sh больше не требует дубликат.
